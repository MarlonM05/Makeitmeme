// Cloudflare Workers (statische Seite): Cloudflare baut und veröffentlicht das Spiel
// automatisch bei jedem Push auf main, sobald das Repo im Cloudflare-Dashboard verbunden ist.
// "name" muss genau dem Worker-Namen im Dashboard entsprechen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makeitmeme",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
